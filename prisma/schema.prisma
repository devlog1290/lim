generator client {
 provider = "prisma-client-js"
}

datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}

model User {
 id String @id @default(cuid())
 name String
 email String @unique
 xp Int @default(0)
 coins Int @default(0)
}

model Question {
 id String @id @default(cuid())
 text String
 category String
 type String
 answer String
}
